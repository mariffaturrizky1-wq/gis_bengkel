#--------------------------------------------------------------------
# ENVIRONMENT (development atau production)
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/gis_bengkel/public/'

# Jika menggunakan virtual host seperti gis_bengkel.test, ganti di atas.
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = gis_bengkel
database.default.username = postgres
database.default.password = Bapakkau
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.schema = gis_bengkel
database.default.port = 5432

